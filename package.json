{
  "name": "dolphindb-extension",
  "version": "0.1.0-alpha.6",
  "description": "Visual DolphinDB connection management for Jupyter",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "styleModule": "style/index.js",
  "files": [
    "lib/**/*",
    "schema/**/*.json",
    "style/**/*"
  ],
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "scripts": {
    "build": "tsc && jupyter-builder build .",
    "build:prod": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/frontend/settings.test.ts tests/frontend/dos.test.cjs tests/frontend/notebook.test.cjs tests/frontend/language.test.cjs tests/frontend/workspace.test.cjs tests/frontend/output.test.cjs tests/frontend/sessions.test.cjs tests/frontend/data.test.cjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@jupyter/react-components": "^0.16.7",
    "@jupyterlab/application": "^4.2.0",
    "@jupyterlab/apputils": "^4.2.0",
    "@jupyterlab/codeeditor": "^4.2.0",
    "@jupyterlab/codemirror": "^4.2.0",
    "@jupyterlab/completer": "^4.2.0",
    "@jupyterlab/coreutils": "^6.2.0",
    "@jupyterlab/docmanager": "^4.2.0",
    "@jupyterlab/docregistry": "^4.2.0",
    "@jupyterlab/filebrowser": "^4.2.0",
    "@jupyterlab/fileeditor": "^4.2.0",
    "@jupyterlab/launcher": "^4.2.0",
    "@jupyterlab/nbformat": "^4.2.0",
    "@jupyterlab/notebook": "^4.2.0",
    "@jupyterlab/outputarea": "^4.2.0",
    "@jupyterlab/rendermime": "^4.2.0",
    "@jupyterlab/running": "^4.2.0",
    "@jupyterlab/services": "^7.2.0",
    "@jupyterlab/settingregistry": "^4.2.0",
    "@jupyterlab/ui-components": "^4.2.0",
    "@lezer/highlight": "^1.2.0",
    "@lumino/commands": "2.3.4",
    "@lumino/coreutils": "^2.2.3",
    "@lumino/disposable": "^2.1.6",
    "@lumino/messaging": "^2.0.0",
    "@lumino/signaling": "^2.1.6",
    "@lumino/widgets": "^2.3.0",
    "dolphindb": "3.1.41",
    "echarts": "6.0.0",
    "lucide": "1.44.0",
    "plotly.js-gl3d-dist-min": "3.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageserver-types": "^3.17.5",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "xshell": "1.3.48"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "typescript": "~5.9.3"
  },
  "jupyterlab": {
    "extension": true,
    "disabledExtensions": [
      "@jupyterlab/notebook-extension:cell-executor"
    ],
    "sharedPackages": {
      "lucide": false,
      "vscode-languageserver-types": false,
      "vscode-languageserver-textdocument": false,
      "@codemirror/state": {
        "singleton": true
      },
      "@codemirror/view": {
        "singleton": true
      },
      "@codemirror/language": {
        "singleton": true
      },
      "@codemirror/autocomplete": {
        "singleton": true
      }
    },
    "schemaDir": "schema",
    "outputDir": "src/dolphindb_extension/labextension",
    "discovery": {
      "server": {
        "managers": [
          "pip"
        ],
        "base": {
          "name": "dolphindb_extension"
        }
      }
    }
  }
}
